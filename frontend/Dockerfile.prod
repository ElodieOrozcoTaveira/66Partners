# ── Stage 1 : build Vite ─────────────────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
COPY shared/package.json   ./shared/
COPY backend/package.json  ./backend/
COPY frontend/package.json ./frontend/

RUN npm ci

COPY frontend/ ./frontend/

# URL de l'API injectée au build (Vite remplace import.meta.env.VITE_API_URL)
ARG VITE_API_URL=https://api.66partners.fr
ENV VITE_API_URL=$VITE_API_URL

# Client ID Google (Google Identity Services) — pas un secret, mais laissé
# vide par défaut : sans valeur explicite au build, le bouton "Continuer avec
# Google" reste simplement inactif plutôt que de pointer vers un client ID
# non voulu.
ARG VITE_GOOGLE_CLIENT_ID=
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID

# App ID Facebook Login (SDK JS) — même logique que Google ci-dessus : pas un
# secret, vide par défaut (bouton Facebook inactif sans valeur explicite).
ARG VITE_FACEBOOK_APP_ID=
ENV VITE_FACEBOOK_APP_ID=$VITE_FACEBOOK_APP_ID

WORKDIR /app/frontend
RUN npx vite build

# ── Stage 2 : nginx ───────────────────────────────────────────────────────────
FROM nginx:1.29-alpine

# Fichiers statiques compilés
COPY --from=builder /app/frontend/dist  /usr/share/nginx/html

# Config nginx (reverse proxy + SPA) — paramétrable pour pouvoir réutiliser ce
# même Dockerfile pour le staging (nginx/staging.conf, domaines distincts)
# sans jamais toucher au comportement de la prod : la valeur par défaut
# reproduit exactement l'ancien COPY figé.
ARG NGINX_CONF=nginx/default.conf
COPY ${NGINX_CONF} /etc/nginx/conf.d/default.conf

EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]
