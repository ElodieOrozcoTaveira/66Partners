VITE_API_URL=http://localhost:3000

# Client ID Google (Google Identity Services) — pas un secret, jamais le
# Client Secret ici. Doit correspondre à un client OAuth "Application Web"
# dont les origines autorisées couvrent l'URL depuis laquelle le frontend est
# servi (http://localhost:5173 en dev).
VITE_GOOGLE_CLIENT_ID=

# App ID Facebook Login (SDK JS) — pas un secret, jamais l'App Secret ici.
# Origine autorisée à configurer dans Meta for Developers : http://localhost:5173.
VITE_FACEBOOK_APP_ID=
