# --- Environnement ---
NODE_ENV=development
PORT=3000
HOST=localhost

# --- Base de données (Postgres exposé par docker-compose.dev.yml sur 5432) ---
DATABASE_URL=postgresql://user:password@localhost:5432/database

# --- Redis (exposé par docker-compose.dev.yml sur 6379) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_SECRET=<JWT_SECRET>

# --- Accès admin (indépendant des comptes utilisateurs) ---
# Hash argon2 du mot de passe admin — générer avec :
# node -e "require('argon2').hash('votre-mot-de-passe').then(console.log)"
ADMIN_PASSWORD_HASH=<ADMIN_PASSWORD_HASH>
ADMIN_JWT_SECRET=<ADMIN_JWT_SECRET>

# --- CORS (origine du frontend Vite) ---
CORS_ORIGIN=http://localhost:5173

# --- Web Push (notifications navigateur/PWA) ---
# Générer une paire avec : node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=<VAPID_PUBLIC_KEY>
VAPID_PRIVATE_KEY=<VAPID_PRIVATE_KEY>
# Contact affiché aux fournisseurs de push (Google/Mozilla/Apple) en cas d'abus.
VAPID_SUBJECT=mailto:contact@66partners.fr
