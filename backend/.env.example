# --- Environnement ---
NODE_ENV=development
PORT=3000
HOST=localhost

# --- Base de données (Postgres exposé par docker-compose.dev.yml sur 5432) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/66partners

# --- Redis (exposé par docker-compose.dev.yml sur 6379) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_SECRET=<JWT_SECRET>

# --- CORS (origine du frontend Vite) ---
CORS_ORIGIN=http://localhost:5173
