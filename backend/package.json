{
  "name": "backend",
  "version": "1.0.0",
  "description": "66Partners",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "pretest": "tsx scripts/migrate-test.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules DOTENV_CONFIG_QUIET=true jest --forceExit",
    "db:test:migrate": "tsx scripts/migrate-test.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:init": "tsx src/db/migrate.ts --init",
    "db:migrate:prod": "node dist/src/db/migrate.js",
    "db:migrate:prod:init": "node dist/src/db/migrate.js --init",
    "db:seed": "npm run db:migrate && tsx src/db/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "argon2": "^0.44.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^1.0.0-rc.4",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "jest": "^30.4.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "sanitize-html": "^2.17.5",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.0.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "drizzle-kit": "^1.0.0-rc.4",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  }
}
