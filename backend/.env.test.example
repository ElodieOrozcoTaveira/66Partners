# --- Environnement de test (utilisé par Jest) ---
NODE_ENV=test
PORT=3001
HOST=localhost

# --- Base de données de test, dédiée et distincte de la base de dev ---
# À créer une fois : docker exec 66partners-postgres-1 createdb -U partners66 partners_test
# Puis migrer :       DATABASE_URL=... npx drizzle-kit migrate
DATABASE_URL=postgresql://partners66:camiyana@localhost:5432/partners_test

# --- Redis (exposé par docker-compose.dev.yml sur 6379) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_SECRET=test_secret_key_for_jwt_signing_in_tests

# --- CORS (origine du frontend Vite) ---
CORS_ORIGIN=http://localhost:5173
