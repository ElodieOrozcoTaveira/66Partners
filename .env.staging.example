# --- Staging PUBLIC (Hetzner) : base et secrets DÉDIÉS, jamais partagés
# avec dev/test/prod. Copier en .env.staging sur le serveur (jamais commité,
# .env.staging est ignoré par Git) et remplir avant de lancer :
#
#   docker compose --env-file .env.staging -f docker-compose.staging.yml up -d --build
#
# IMPORTANT — le flag --env-file est OBLIGATOIRE : sans lui, Docker Compose
# charge silencieusement le .env par défaut du répertoire courant (celui du
# dev, s'il en existe un) pour résoudre les ${VAR} du compose file, jamais ce
# fichier-ci. Vérifié : c'est un piège réel de Docker Compose, pas une
# précaution théorique.
#
# IMPORTANT — toute valeur contenant un "$" (ex. ADMIN_PASSWORD_HASH, un hash
# argon2 du type $argon2id$v=19$...) DOIT avoir chaque "$" doublé en "$$"
# ci-dessous, sous peine d'être silencieusement tronquée par l'interpolation
# Docker Compose (vérifié : sans "$$", "$argon2id$v=19$m=..." devient
# "=19=..." dans le conteneur — un admin ne pourrait plus se connecter).
#
# Voir docs/staging.md pour la procédure complète (migrations, seed, HTTPS).

# --- Base de données staging (conteneur postgres-staging dédié, jamais dev/prod) ---
DB_USER=partners_staging
DB_PASSWORD=
DB_NAME=partners_staging

# --- Auth — générer des secrets propres au staging, JAMAIS ceux de prod ---
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
ADMIN_JWT_SECRET=
# node -e "require('argon2').hash('votre-mot-de-passe').then(console.log)"
# Puis doubler chaque "$" du résultat avant de le coller ici (cf. avertissement en haut de fichier).
ADMIN_PASSWORD_HASH=

# --- CORS / origine frontend staging (domaines publics réels) ---
CORS_ORIGIN=https://staging.66partners.fr
FRONTEND_URL=https://staging.66partners.fr

# --- Connexion Google (Google Identity Services) ---
# Client ID OAuth "Application Web" dédié au staging (origines autorisées :
# https://staging.66partners.fr) — PAS un secret, mais distinct de celui de
# prod pour ne jamais mélanger les origines autorisées. Réutilisé à la fois
# côté backend (GOOGLE_CLIENT_ID) et injecté au build frontend
# (VITE_GOOGLE_CLIENT_ID) par docker-compose.staging.yml.
GOOGLE_CLIENT_ID=

# --- Connexion Facebook (Facebook Login for the Web) ---
# App ID Meta (couvre 66partners.fr et staging.66partners.fr sur cette app) —
# PAS un secret. Réutilisé côté backend (FACEBOOK_APP_ID) et injecté au build
# frontend (VITE_FACEBOOK_APP_ID) par docker-compose.staging.yml.
# App Secret : jamais dans VITE_*, jamais dans Git — backend uniquement.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Web Push (optionnel — l'app démarre même si absent) ---
# node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@66partners.fr

# --- Email (optionnel — l'inscription réussit même si l'envoi échoue) ---
SMTP_USER=
SMTP_PASSWORD=
