# --- Environnement ---
DB_NODE_ENV=
DB_PORT=
DB_HOST=

DATABASE_URL=postgresql://user:password@localhost:5433/databse

DB_USER=
DB_PASSWORD=
DB_NAME=partnrs
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
JWT_SECRET=
CORS_ORIGIN=
FRONTEND_URL=

# --- Connexion Google (Google Identity Services) — Client ID "Application Web",
# pas un secret (exposé aussi côté frontend sous VITE_GOOGLE_CLIENT_ID) ---
GOOGLE_CLIENT_ID=


# --- Accès admin (indépendant des comptes utilisateurs) ---
# Hash argon2 du mot de passe admin — générer avec :
# node -e "require('argon2').hash('votre-mot-de-passe').then(console.log)"
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=
# Adresse recevant le lien de réinitialisation du mot de passe admin
# ("mot de passe oublié" côté /admin, il n'y a qu'un seul admin donc pas
# d'email à saisir, la cible est fixe)
ADMIN_RECOVERY_EMAIL=

# Resend Mail
RESEND_API_KEY= 
MAIL_FROM= 

#OVH
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="mail>"

# --- Web Push (notifications navigateur/PWA) ---
# Générer une paire avec : node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@66partners.fr

# Strava (https://www.strava.com/settings/api). Le domaine de
# STRAVA_REDIRECT_URI doit être celui déclaré comme « Authorization Callback
# Domain » sur Strava. Clé de chiffrement des jetons : openssl rand -base64 32
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:3000/api/strava/callback
STRAVA_TOKEN_ENCRYPTION_KEY=