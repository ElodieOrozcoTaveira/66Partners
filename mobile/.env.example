# Copier ce fichier en .env (ignoré par git) et adapter.
# Ces valeurs sont publiques : elles sont incluses dans l'application compilée.
# Ne jamais y mettre de secret.

# Origine du backend, sans /api.
#   Staging    : https://api-staging.66partners.fr
#   Production : https://api.66partners.fr (valeur par défaut si absent)
#   Local      : http://<IP-de-ta-machine>:3000 (pas localhost depuis un téléphone)
EXPO_PUBLIC_API_ORIGIN=https://api-staging.66partners.fr

# Site web (pages légales, réinitialisation du mot de passe).
EXPO_PUBLIC_WEB_ORIGIN=https://staging.66partners.fr

# Connexion Google (identifiants OAuth publics, Google Cloud Console).
# WEB : le même client que le site (VITE_GOOGLE_CLIENT_ID) et le backend
# (GOOGLE_CLIENT_ID). Sans lui, le bouton Google est masqué.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# IOS : client OAuth de type iOS (bundle id de l'app). Requis sur iPhone.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
